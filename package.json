{
  "name": "tasawwur",
  "version": "0.0.0",
  "private": true,
  "description": "Generate narrated short videos from a topic or a script.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @tasawwur/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "api": "echo 'Run the Python engine: see docs/RUNNING.md'"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "ws": "^8.22.2"
  }
}