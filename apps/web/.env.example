# Everything has a working default. These only override where things live.

# Rendered videos and uploaded footage.
# TASAWWUR_STORAGE=/path/to/storage

# Settings file, including API keys.
# TASAWWUR_SETTINGS=/path/to/settings.json

# ffmpeg, if it is not on PATH.
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe
